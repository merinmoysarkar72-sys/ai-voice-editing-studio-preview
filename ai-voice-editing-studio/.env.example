# Optional access protection. Set a long random token before exposing the API publicly.
AVES_ACCESS_TOKEN=
# Only needed when frontend and API are hosted on different origins.
AVES_ALLOWED_ORIGINS=
# Persistent private project storage directory.
AVES_DATA_DIR=./data
AVES_MAX_AUDIO_MB=500
AVES_MAX_SCRIPT_MB=20
# Multilingual Whisper model: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Set AVES_ENV=production in public deployments. Configure one or more auth tokens.
AVES_ENV=development
# Single-user mode: AVES_ACCESS_TOKEN=replace-with-a-long-random-secret
# Multi-user mode: AVES_USERS_JSON={"long-random-token-a":"user-a","long-random-token-b":"user-b"}

# Optional whisper.cpp model file for the final fallback engine.
WHISPER_CPP_MODEL_PATH=
